# The web container: the built skin at /, /api and the MCP server at /mcp proxied to the api
# container. Sign-in lives in one place, the api (auth.py): it refuses /api and /mcp without a
# session or token. The skin is static files with no data in them, served to anyone, so its
# sign-in page can load.
{
	admin off
	servers {
		# Tailscale Serve, or another proxy on the host, terminates https: keep its
		# X-Forwarded-Proto so the api marks the session cookie Secure.
		trusted_proxies static private_ranges
	}
}

:8000 {
	handle /api/* {
		# Event streams go out as they are written, never buffered.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /mcp {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		# Client routes like /gates get index.html, as the api's SpaFiles does natively.
		try_files {path} /index.html
		file_server
	}
}
